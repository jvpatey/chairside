# Chairside mobile — copy to .env for local development.
# EAS production/preview builds need the same EXPO_PUBLIC_* keys via `eas env:create`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Optional — clinic subscriptions (RevenueCat)
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-revenuecat-ios-public-sdk-key
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-revenuecat-android-public-sdk-key
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=your-revenuecat-web-billing-public-sdk-key

# Optional
# EXPO_PUBLIC_WEB_BASE_URL=https://chairside.app
# EXPO_PUBLIC_CLINIC_GROUPS_ENABLED=1
